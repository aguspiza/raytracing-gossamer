// Rays, materials, the sphere scene and the camera.

use seed::Seed
use vec3::Vec3

pub (package) const MAX_SPHERES: i64 = 512
pub (package) const FAR: f32 = 1_000_000_000.0
const T_MIN: f32 = 0.01

pub (package) struct Ray { pub (package) origin: Vec3, pub (package) dir: Vec3 }

pub (package) enum Material {
    Lambertian { albedo: Vec3 }
    Metal { albedo: Vec3, fuzz: f32 }
    Dielectric { ior: f32 }
}

// The spheres as flat f32 arrays: the hit test reads only cx..r2, in a
// branch-free pass LLVM can vectorize.
pub (package) struct Scene {
    cx: Vec<f32>
    cy: Vec<f32>
    cz: Vec<f32>
    r2: Vec<f32>
    radius: Vec<f32>
    materials: Vec<Material>
}

impl Scene {
    // The random sphere scene of the book, built as raytracing-bend2 builds it
    // (by prepending): the ground, the kept grid cells from the last to the
    // first, then the three big spheres. Same order, so ties go the same way.
    pub (package) fn random() -> Scene {
        let mut s = Scene { cx: #[], cy: #[], cz: #[], r2: #[], radius: #[], materials: #[] }
        s.push(Vec3 { x: 0.0, y: -1000.0, z: 0.0 }, 1000.0, Material::Lambertian { albedo: Vec3 { x: 0.5, y: 0.5, z: 0.5 } })
        let tilt: f32 = 0.2
        // the 22 x 22 grid, cell k at (k / 22 - 11, k % 22 - 11)
        for k in (0..484).rev() {
            let h = (k * 16 + 1000) as u32
            let choose = Seed::at(h, 0)
            let x = (k / 22) as f32 - 11.0 + 0.9 + Seed::at(h, 1)
            let z = (k % 22) as f32 - 11.0 + 0.9 + Seed::at(h, 2)
            let c = Vec3 { x: x, y: 0.2, z: z }
            if (c - Vec3 { x: 4.0, y: 0.2, z: 0.0 }).len() > 0.9 {
                let y = 0.2 - tilt / 45.0 * c.len() // sink the far ones into the curved floor
                s.push(Vec3 { x: x, y: y, z: z }, 0.2, Scene::cell_material(choose, h))
            }
        }
        s.push(Vec3 { x: 0.0, y: 1.0, z: 0.0 }, 1.0, Material::Dielectric { ior: 1.5 })
        s.push(Vec3 { x: -4.0, y: 1.0, z: 0.0 }, 1.0, Material::Lambertian { albedo: Vec3 { x: 0.4, y: 0.2, z: 0.1 } })
        s.push(Vec3 { x: 4.0, y: 1.0, z: 0.0 }, 1.0, Material::Metal { albedo: Vec3 { x: 0.7, y: 0.6, z: 0.5 }, fuzz: 0.01 })
        s
    }

    // A grid cell's material from its random numbers h + 3, h + 4, ..
    fn cell_material(choose: f32, h: u32) -> Material {
        if choose < 0.8 {
            Material::Lambertian {
                albedo: Vec3 {
                    x: Seed::at(h, 3) * Seed::at(h, 4)
                    y: Seed::at(h, 5) * Seed::at(h, 6)
                    z: Seed::at(h, 7) * Seed::at(h, 8)
                }
            }
        } else if choose < 0.95 {
            Material::Metal {
                albedo: Vec3 { x: 0.5 * (Seed::at(h, 3) + 1.0), y: 0.5 * (Seed::at(h, 4) + 1.0), z: 0.5 * (Seed::at(h, 5) + 1.0) }
                fuzz: 0.01
            }
        } else {
            Material::Dielectric { ior: 1.5 }
        }
    }

    fn push(&mut self, c: Vec3, r: f32, m: Material) {
        self.cx.push(c.x)
        self.cy.push(c.y)
        self.cz.push(c.z)
        self.r2.push(r * r)
        self.radius.push(r)
        self.materials.push(m)
    }

    pub (package) fn len(&self) -> i64 { self.cx.len() }

    pub (package) fn center(&self, i: i64) -> Vec3 { Vec3 { x: self.cx[i], y: self.cy[i], z: self.cz[i] } }

    pub (package) fn radius(&self, i: i64) -> f32 { self.radius[i] }

    pub (package) fn material(&self, i: i64) -> Material { self.materials[i] }

    // The nearest sphere in (T_MIN, FAR): its index and t. Two passes: the
    // first, with no branches, works out qb and the discriminant of every
    // sphere; the second takes the sqrt only where the discriminant is positive.
    pub (package) fn hit(&self, r: Ray) -> Option<(i64, f32)> {
        let mut qbs = [0.0f32; MAX_SPHERES]
        let mut discs = [0.0f32; MAX_SPHERES]
        let o = r.origin
        let d = r.dir
        let qa = d.dot(d)
        let n = self.len()
        for i in 0..n {
            let x = o.x - self.cx[i]
            let y = o.y - self.cy[i]
            let z = o.z - self.cz[i]
            let qb = x * d.x + y * d.y + z * d.z
            let qc = x * x + y * y + z * z - self.r2[i]
            qbs[i] = qb
            discs[i] = qb * qb - qa * qc
        }
        let mut best: Option<(i64, f32)> = None
        let mut t_max = FAR
        for i in 0..n {
            let disc = discs[i]
            if disc > 0.0 {
                let qb = qbs[i]
                let sq = disc.sqrt()
                let near = (0.0 - qb - sq) / qa
                if near > T_MIN && near < t_max {
                    t_max = near
                    best = Some((i, near))
                } else {
                    let far = (0.0 - qb + sq) / qa
                    if far > T_MIN && far < t_max {
                        t_max = far
                        best = Some((i, far))
                    }
                }
            }
        }
        best
    }
}

pub (package) struct Camera {
    origin: Vec3
    corner: Vec3
    horizontal: Vec3
    vertical: Vec3
    u: Vec3
    v: Vec3
    lens_radius: f32
}

impl Camera {
    pub (package) fn new(look_from: Vec3, look_at: Vec3, vfov_deg: f32 = 20.0, aspect: f32 = 2.0, aperture: f32 = 0.005) -> Camera {
        let vup = Vec3 { x: 0.0, y: 1.0, z: 0.0 }
        let dist = look_from - look_at
        let w = dist.normalize()
        let u = vup.cross(w).normalize()
        let v = w.cross(u)
        let focus = dist.len()
        let pi: f32 = 3.14159265
        let half_h = (vfov_deg * pi / 180.0 / 2.0).tan()
        let half_w = aspect * half_h
        Camera {
            origin: look_from
            // v points up and rows go top to bottom: the corner is the top
            // left, and the vertical span points down
            corner: look_from - u * (half_w * focus) + v * (half_h * focus) - w * focus
            horizontal: u * (half_w * focus * 2.0)
            vertical: v * (0.0 - half_h * focus * 2.0)
            u: u
            v: v
            lens_radius: aperture / 2.0
        }
    }

    // The ray through (s, t) of the image, both from the top left, leaving
    // from point `d` of the lens disk.
    pub (package) fn ray(&self, s: f32, t: f32, d: Vec3) -> Ray {
        let offset = self.u * (d.x * self.lens_radius) + self.v * (d.y * self.lens_radius)
        let uh = self.horizontal * s
        let vv = self.vertical * t - self.origin - offset
        Ray { origin: self.origin - offset, dir: self.corner + (uh + vv) }
    }
}
