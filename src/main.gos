// Ray Tracing in One Weekend: the book's final scene, rendered on every core.
//
//     gos build --release
//     ./target/release/raytracing-gossamer [samples] [ppm]
//
// The math, the random numbers and the scene follow raytracing-bend2,
// raytracing-goose and the Nim `optimized` branch operation by operation, all
// in f32, so all of them write the same ray.tga.

use std::{env, errors, fs, time}
use image::{ppm, tga, Rgb, BLACK}
use scene::{Camera, Material, Ray, Scene}
use seed::Seed
use vec3::{Vec3, ONE, ZERO}

const W: i64 = 1200
const H: i64 = 600
const BOUNCES: i64 = 49

fn sky(d: Vec3) -> Vec3 {
    let t = 0.5 * (d.normalize().y + 1.0)
    ONE * (1.0 - t) + Vec3 { x: 0.5, y: 0.7, z: 1.0 } * t
}

fn schlick(cosine: f32, ior: f32) -> f32 {
    let r0 = (1.0 - ior) / (1.0 + ior)
    let r = r0 * r0
    r + (1.0 - r) * (1.0 - cosine).powf(5.0)
}

// Up to 49 bounces, then a last hit test, whose hit is black.
// `s` is left at the generator state after this path.
fn color(ray: Ray, scene: Scene, s: &mut Seed) -> Vec3 {
    let mut ray = ray
    let mut light = ONE
    for _ in 0..BOUNCES {
        let Some((i, t)) = scene.hit(ray) else { return light * sky(ray.dir) }
        let d = ray.dir
        let p = ray.origin + d * t
        let normal = (p - scene.center(i)) / scene.radius(i)
        match scene.material(i) {
            Material::Lambertian { albedo } => {
                let c = s.in_sphere()
                let target = p + normal + c.point3()
                ray = Ray { origin: p, dir: target - p }
                light = light * albedo
                *s = c.skip(3)
            }
            Material::Metal { albedo, fuzz } => {
                let c = s.in_sphere()
                let dir = d.normalize().reflect(normal) + c.point3() * fuzz
                *s = c.skip(3)
                if dir.dot(normal) <= 0.0 { return ZERO }
                ray = Ray { origin: p, dir: dir }
                light = light * albedo
            }
            Material::Dielectric { ior } => {
                let dn = d.dot(normal)
                let inside = dn > 0.0
                let out_normal = if inside { -normal } else { normal }
                let ni = if inside { ior } else { 1.0 / ior }
                let cos0 = 0.0 - dn / d.len()
                let cosine = if inside { 0.0 - cos0 * ior } else { cos0 }
                let nv = d.normalize()
                let dt = nv.dot(out_normal)
                let disc = 1.0 - ni * ni * (1.0 - dt * dt)
                let through = disc > 0.0 && s.unit() > schlick(cosine, ior)
                let dir = if through { (nv - out_normal * dt) * ni - out_normal * disc.sqrt() } else { d.reflect(normal) }
                ray = Ray { origin: p, dir: dir }
                *s = s.next()
            }
        }
    }
    if scene.hit(ray).is_none() { light * sky(ray.dir) } else { ZERO }
}

// Gamma 2, then the byte; wraps like the C and Nim ports.
fn to_byte(x: f32) -> u8 { ((255.99 * x.sqrt()) as u32 & 255) as u8 }

// One image row, every pixel with all its samples. Each pixel seeds its own generator.
fn render_row(y: i64, row: &mut [Rgb], camera: Camera, scene: Scene, samples: i64) {
    for x in 0..W {
        let mut s = Seed::hashed((y * W + x + 1) as u32)
        let mut sum = ZERO
        for _ in 0..samples {
            let d = s.skip(2).in_disk()
            let ray = camera.ray((x as f32 + s.unit()) / W as f32, (y as f32 + s.next().unit()) / H as f32, d.point2())
            s = d.skip(2)
            sum = sum + color(ray, scene, &mut s)
        }
        let m = sum / samples as f32
        row[x] = Rgb { r: to_byte(m.x), g: to_byte(m.y), b: to_byte(m.z) }
    }
}

fn main() -> Result<(), errors::Error> {
    // [samples] [ppm], as the Nim, Goose and Bend ports take them
    let mut samples = 64
    let mut want_ppm = false
    for a in env::args() {
        if a == "ppm" {
            want_ppm = true
        } else if let Some(n) = a.to_i64() {
            samples = n.max(1)
        }
    }
    println(f"rendering {W}x{H} at {samples} samples per pixel")

    let scene = Scene::random()
    let camera = Camera::new(Vec3 { x: -1.0, y: 1.0, z: 18.0 }, Vec3 { x: 0.0, y: 1.0, z: -1.0 })
    let start = time::Instant::now()
    let mut pixels = #[BLACK; W * H]
    pixels.par_chunks_mut(W, |y, row| render_row(y, row, camera, scene, samples))
    println(f"rendered in {start.elapsed().as_millis()} ms")

    fs::write("ray.tga", tga(W, H, pixels))?
    println("wrote ray.tga")
    if want_ppm {
        fs::write("ray.ppm", ppm(W, H, pixels).as_bytes())?
        println("wrote ray.ppm")
    }
    Ok(())
}
