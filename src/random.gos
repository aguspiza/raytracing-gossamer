// Random samples for the renderer.
//
// std::math::rand::Rng is native code, and `par_chunks_mut` only takes pure
// callbacks, so this is a small xorshift32 written in Gossamer. Each image row
// gets its own, seeded from the row number: rows render in parallel and the
// image is the same on every run.

use vec3::{Vec3, ONE}

pub (package) struct Rng { state: u32 }

impl Rng {
    pub (package) fn seeded(seed: u32) -> Rng {
        let mut x = seed
        x ^= x >> 16
        x = x *% 0x7feb352d
        x ^= x >> 15
        x = x *% 0x846ca68b
        x ^= x >> 16
        Rng { state: x | 1 } // xorshift never leaves zero
    }

    // Uniform in [0, 1).
    pub (package) fn next(&mut self) -> f32 {
        self.state ^= self.state <<% 13
        self.state ^= self.state >> 17
        self.state ^= self.state <<% 5
        (self.state >> 8) as f32 / 16777216.0
    }

    // Kept as in the Nim original: it rejects the points inside the unit
    // sphere, so it answers points of the cube outside it.
    pub (package) fn in_sphere(&mut self) -> Vec3 {
        loop {
            let p = Vec3 { x: self.next(), y: self.next(), z: self.next() } * 2.0 - ONE
            if p.sqlen() >= 1.0 { break p }
        }
    }

    // Same rejection as in_sphere, on the z = 0 plane.
    pub (package) fn in_disk(&mut self) -> Vec3 {
        loop {
            let p = Vec3 { x: self.next() * 2.0 - 1.0, y: self.next() * 2.0 - 1.0, z: 0.0 }
            if p.sqlen() >= 1.0 { break p }
        }
    }
}

#[cfg(test)]
mod tests {
    use super::Rng

    #[test]
    fn next_is_in_unit_range() {
        let mut rng = Rng::seeded(42)
        for _ in 0..10_000 {
            let x = rng.next()
            assert(x >= 0.0 && x < 1.0)
        }
    }

    #[test]
    fn same_seed_same_sequence() {
        let mut a = Rng::seeded(7)
        let mut b = Rng::seeded(7)
        assert_eq(a.next(), b.next())
    }
}
